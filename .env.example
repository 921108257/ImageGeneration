# OpenAI（必填）
OPENAI_API_KEY=sk-your-key-here
# 留空时使用 OpenAI 官方 https://api.openai.com/v1
# OPENAI_BASE_URL=https://your-compatible-gateway.example.com/v1
# 可选：gpt-image-2 的 1K 及以下图片优先使用专用 Key；未配置时自动回退 OPENAI_API_KEY
# OPENAI_API_KEY_1K=sk-your-small-image-key
# GPT_IMAGE_2_1K_API_KEY=sk-your-small-image-key  # OPENAI_API_KEY_1K 的别名
# IMAGE_1K_MAX_EDGE=1024
IMAGE_MODEL=gpt-image-2
REQUEST_TIMEOUT=300
MAX_CONCURRENT_GENERATIONS=4

# 上传限制（字节）
MAX_UPLOAD_BYTES=52428800
MAX_UPLOAD_TOTAL_BYTES=52428800
MAX_MASK_BYTES=4194304

# 对外部署时必须设置；留空仅适合可信本机开发
SERVICE_API_KEY=
# 单进程固定窗口保护；0 表示关闭。多实例请在 API 网关统一限流。
API_RATE_LIMIT_PER_MINUTE=30

# MCP Streamable HTTP 安全
MCP_DNS_REBINDING_PROTECTION=true
# Host 请求头白名单，逗号分隔；* 不是全局通配符。
# 生产环境同时加入裸域名和带端口形式，例如 image.example.com,image.example.com:*
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*
# 浏览器型 MCP 客户端需要 Origin 时显式填写；服务端客户端通常不发送 Origin
MCP_ALLOWED_ORIGINS=
# base64 编辑输入会放大约 4/3，默认允许约 70MB JSON 请求体
MCP_MAX_REQUEST_BODY_BYTES=73400320

# 可选模型扩展。Qwen 使用 DashScope 原生图像接口；Seedream 使用 Ark OpenAI 兼容接口。
# QWEN_API_KEY=sk-your-dashscope-key
# DASHSCOPE_API_KEY=sk-your-dashscope-key  # QWEN_API_KEY 的别名
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
# QWEN_IMAGE_MODEL=qwen-image-2.0-pro
# SEEDREAM_API_KEY=your-ark-key
# VOLCENGINE_API_KEY=your-ark-key  # SEEDREAM_API_KEY 的别名
# SEEDREAM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# SEEDREAM_IMAGE_MODEL=doubao-seedream-4-0-250828

# 阿里云 OSS（可选）。启用后 base64 图片上传 OSS，REST/MCP 返回公网资源链接。
OSS_ENABLED=false
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_BASE_URL=
OSS_KEY_PREFIX=images
