# OpenAI API 密钥（必填）
OPENAI_API_KEY=sk-your-key-here

# 自定义 BASE_URL（可选，用于代理、Azure OpenAI 兼容端点或第三方镜像）
# 未设置时使用官方地址：https://api.openai.com/v1
# OPENAI_BASE_URL=https://your-proxy.example.com/v1

# 默认图像模型
IMAGE_MODEL=gpt-image-1

# 上传文件大小上限（字节），默认 8MB
MAX_UPLOAD_BYTES=8388608

# 请求超时（秒）
REQUEST_TIMEOUT=120

# ===== 阿里云 OSS 配置（可选）=====
# 启用后生成的 b64 图片自动上传 OSS，响应返回 OSS 链接；
# OSS_ENABLED=false 时保持原有行为（直接返回 base64）
OSS_ENABLED=false
# 例如：oss-cn-hangzhou.aliyuncs.com
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 自定义公网访问域名（可选，如 CDN/已绑定域名）；留空则用 bucket.endpoint 默认域名
OSS_PUBLIC_BASE_URL=
# 对象 key 前缀（可选，默认 images）
# OSS_KEY_PREFIX=images
